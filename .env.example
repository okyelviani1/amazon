# ============================================
# KONFIGURASI SERVER
# ============================================
PORT=3000
NODE_ENV=development

# ============================================
# KONFIGURASI TELEGRAM BOT API
# ============================================
# Token bot Telegram, dapatkan dari @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ID Chat penerima notifikasi (bisa berupa array dipisah koma untuk multiple)
# Contoh: 123456789 atau 123456789,987654321
TELEGRAM_CHAT_ID=your_chat_id_here

# ============================================
# KONFIGURASI SMTP EMAIL
# ============================================
# Server SMTP (contoh: smtp.gmail.com untuk Gmail, smtp.mail.yahoo.com untuk Yahoo)
SMTP_HOST=smtp.gmail.com

# Port SMTP (587 untuk TLS, 465 untuk SSL)
SMTP_PORT=587

# Gunakan koneksi aman TLS
SMTP_SECURE=false

# Kredensial akun email pengirim
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_password_or_app_password

# Nama pengirim yang ditampilkan di email
SMTP_FROM_NAME="Form Notification System"

# Alamat email penerima notifikasi (bisa multiple dipisah koma)
SMTP_TO=recipient1@example.com,recipient2@example.com

# ============================================
# KONFIGURASI KEAMANAN
# ============================================
# Set true untuk enable HTTPS (memerlukan sertifikat SSL)
ENABLE_HTTPS=false

# Path sertifikat SSL jika HTTPS diaktifkan
SSL_CERT_PATH=./certs/cert.pem
SSL_KEY_PATH=./certs/key.pem
